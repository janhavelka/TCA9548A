# Doxygen configuration for TCA9548A.
# PROJECT_NUMBER is synchronized from library.json by generate_version.py.

PROJECT_NAME           = "TCA9548A"
PROJECT_NUMBER         = "1.1.5"
PROJECT_BRIEF          = "TCA9548A embedded library API documentation"
OUTPUT_DIRECTORY       = .doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO

INPUT                  = README.md \
                         CHANGELOG.md \
                         CONTRIBUTING.md \
                         SECURITY.md \
                         AGENTS.md \
                         LICENSE \
                         include \
                         docs/FEATURE_MATRIX.md \
                         docs/HARDWARE_NOTES.md \
                         docs/NAMING_HYGIENE.md \
                         docs/PORTING.md \
                         docs/VALIDATION_STATUS.md
FILE_PATTERNS          = *.h *.md *
EXTENSION_MAPPING      = no_extension=md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.doxygen/* */.pio/* */.git/* */test/*
EXAMPLE_PATH           = examples/01_basic_bringup_cli

USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
